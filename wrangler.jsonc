{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silsigan-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "silsigan-web-staging"
    },
    "production": {
      "name": "silsigan-web-production"
    }
  }
}
