    "expo-doctor": "^1.18.22",
    "get-tsconfig": "^4.14.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "brace-expansion@<2.0.0": "1.1.16",
