NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SILSIGAN_STORE_DRIVER=demo
SILSIGAN_ADMIN_TOKEN=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Local information dashboard. Never prefix these provider secrets with NEXT_PUBLIC_.
# Public Data Portal: use the decoded key; each service must be approved for your account.
KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=
KOREA_DATA_API_KEY=
KAKAO_REST_API_KEY=

# Map each supported region to a verified AirKorea station; no automatic nearest-station claim.
# Example structure only: {"ulsan":"your-verified-station-name"}
AIRKOREA_STATIONS={}

# Read reviewed, recent public posts from the existing Supabase tables.
# Also requires SILSIGAN_STORE_DRIVER=supabase and Supabase public read/RLS configuration.
LOCAL_LIVE_COMMUNITY_ENABLED=false

# Legacy demo writes are development-only; production/hosted writes stay disabled.
SILSIGAN_ENABLE_LEGACY_DEMO_WRITES=false
